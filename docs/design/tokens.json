{
  "$comment": "Publit design tokens (Ink & Dot). One source for iOS (Swift), Android (Compose) and web (CSS).",
  "color": {
    "light": {
      "background": "#F4F4F2", "surface": "#FFFFFF", "surfaceRaised": "#FFFFFF", "fill": "#EBEBE7",
      "ink": "#111111", "inkSecondary": "#66666B", "inkTertiary": "#9C9CA1", "hairline": "#00000014",
      "onInk": "#FFFFFF", "glass": "#FFFFFFB8"
    },
    "dark": {
      "background": "#0B0B0C", "surface": "#19191B", "surfaceRaised": "#222225", "fill": "#2A2A2D",
      "ink": "#F4F4F2", "inkSecondary": "#A1A1A6", "inkTertiary": "#6E6E73", "hairline": "#FFFFFF14",
      "onInk": "#111111", "glass": "#1E1E21B8"
    },
    "dot": "#FFC531",
    "status": {
      "live": { "light": "#1B7A33", "dark": "#30D158" },
      "delay": { "light": "#B25000", "dark": "#FF9F0A" },
      "danger": { "light": "#D70015", "dark": "#FF453A" }
    }
  },
  "radius": { "card": 22, "control": 14, "badge": 8, "pill": 999 },
  "space": { "xxs": 4, "xs": 8, "s": 12, "m": 16, "l": 20, "xl": 24, "xxl": 32 },
  "stroke": { "route": 6, "routeRatio": "stroke = 0.32 × dot diameter, as in the logo (96 : 116 × 2.6)" },
  "type": {
    "largeTitle": { "size": 34, "weight": 800, "tracking": -0.8 },
    "title": { "size": 22, "weight": 700, "tracking": -0.4 },
    "headline": { "size": 17, "weight": 600 },
    "body": { "size": 17, "weight": 400 },
    "subhead": { "size": 15, "weight": 500 },
    "caption": { "size": 13, "weight": 500 },
    "figure": { "size": 30, "weight": 750, "tracking": -0.8, "numbers": "tabular" },
    "figureSmall": { "size": 20, "weight": 700, "numbers": "tabular" }
  },
  "glass": { "blur": 24, "saturate": 1.6, "use": "only for floating controls: tab bar, live trip bar, map chips" }
}
