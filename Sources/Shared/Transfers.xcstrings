    "Check the destination of your train section. Carriage allocation is not available in Publit.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte cíl své části vlaku. Rozdělení vozů není v aplikaci Publit k dispozici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe das Ziel deines Zugteils. Die Wagenzuordnung ist in Publit nicht verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε τον προορισμό του τμήματος του συρμού σας. Η κατανομή βαγονιών δεν είναι διαθέσιμη στο Publit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the destination of your train section. Carriage allocation is not available in Publit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el destino de tu sección del tren. La asignación de coches no está disponible en Publit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la destination de votre partie du train. L’affectation des voitures n’est pas disponible dans Publit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizd a saját vonatrészed célállomását. A kocsik beosztása nem érhető el a Publitben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la destinazione della tua sezione del treno. L’assegnazione delle carrozze non è disponibile in Publit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de bestemming van je treindeel. De rijtuigindeling is niet beschikbaar in Publit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź cel swojej części pociągu. Informacja o przypisaniu wagonów nie jest dostępna w Publit."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica o destino da tua secção do comboio. A distribuição das carruagens não está disponível no Publit."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică destinația secțiunii tale de tren. Repartizarea vagoanelor nu este disponibilă în Publit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera destinationen för din tågdel. Vagnsindelning finns inte i Publit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tren bölümünüzün varış noktasını kontrol edin. Vagon dağılımı bilgisi Publit’te mevcut değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте пункт призначення своєї частини поїзда. Розподіл вагонів у Publit недоступний."
          }
        }
      }
    },
