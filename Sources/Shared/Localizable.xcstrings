  "Location is off. Choose a start point, or allow location access in Settings.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Location is off. Choose a start point, or allow location access in Settings."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Standort deaktiviert. Wähle einen Startpunkt oder erlaube den Standortzugriff in den Einstellungen."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Localisation désactivée. Choisissez un point de départ ou autorisez la localisation dans Réglages."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Posizione disattivata. Scegli un punto di partenza o consenti l’accesso alla posizione in Impostazioni."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ubicación desactivada. Elige un punto de partida o permite el acceso a la ubicación en Ajustes."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "translated",
      "value": "Localização desativada. Escolha um ponto de partida ou permita o acesso à localização nas Definições."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Locatie staat uit. Kies een vertrekpunt of sta locatietoegang toe in Instellingen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Lokalizacja wyłączona. Wybierz punkt startowy albo zezwól na dostęp do lokalizacji w Ustawieniach."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Геопозицію вимкнено. Виберіть початкову точку або дозвольте доступ до геопозиції в Налаштуваннях."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "translated",
      "value": "Localizarea este dezactivată. Alegeți un punct de plecare sau permiteți accesul la localizare în Configurări."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "translated",
      "value": "Poloha je vypnutá. Vyberte výchozí bod nebo povolte přístup k poloze v Nastavení."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "translated",
      "value": "Platstjänster är av. Välj en startpunkt eller tillåt platsåtkomst i Inställningar."
     }
    },
    "el": {
     "stringUnit": {
      "state": "translated",
      "value": "Η τοποθεσία είναι απενεργοποιημένη. Επιλέξτε σημείο αφετηρίας ή επιτρέψτε την πρόσβαση στην τοποθεσία στις Ρυθμίσεις."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "translated",
      "value": "A helymeghatározás ki van kapcsolva. Válassz kiindulópontot, vagy engedélyezd a helyhozzáférést a Beállításokban."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Konum kapalı. Bir başlangıç noktası seçin veya Ayarlar'da konum erişimine izin verin."
     }
    }
   }
  },
