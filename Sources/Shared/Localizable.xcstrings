  "Save stops from their departure board, lines from a trip, or add places with +.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Save stops from their departure board, lines from a trip, or add places with +."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Speichere Haltestellen über ihre Abfahrtstafel und Linien über eine Fahrt. Orte fügst du mit + hinzu."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Enregistrez les arrêts de leur tableau de départ, les lignes d'un trajet, ou ajoutez des lieux avec +."
     }
    },
    "it": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Salva le fermate dal tabellone delle partenze, le linee di un viaggio o aggiungi luoghi con +."
     }
    },
    "es": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Guarde paradas de su tablero de salidas, líneas de un viaje o agregue lugares con +."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Salve paradas do painel de embarque, linhas de uma viagem ou adicione lugares com +."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Bewaar tussenstops vanaf het vertrekbord, lijnen van een reis of voeg plaatsen toe met +."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Zapisuj przystanki z tablicy odjazdów, linie z podróży lub dodawaj miejsca za pomocą +."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Зберігайте зупинки з дошки відправлення, маршрути з подорожі або додавайте місця за допомогою +."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Salvați opririle din panoul de plecare, liniile dintr-o călătorie sau adăugați locuri cu +."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Uložte zastávky z tabulky odjezdů, linek z cesty nebo přidejte místa pomocí +."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Spara hållplatser från deras avgångstavla, linjer från en resa eller lägg till platser med +."
     }
    },
    "el": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Αποθηκεύστε στάσεις από τον πίνακα αναχώρησης, γραμμές από ένα ταξίδι ή προσθέστε μέρη με +."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Mentse el a megállókat az indulási táblájukról, a vonalakat egy utazásról, vagy adjon hozzá helyeket + jellel."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Kalkış panosundaki durakları, yolculuktaki hatları kaydedin veya + ile yerler ekleyin."
     }
    }
   }
  },
