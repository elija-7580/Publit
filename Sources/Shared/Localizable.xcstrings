"Turn on Live Activities for Publit in Settings to follow it on the lock screen.": {
"extractionState": "manual",
"localizations": {
"en": {
"stringUnit": {
"state": "translated",
"value": "Turn on Live Activities for Publit in Settings to follow it on the lock screen."
}
},
"de": {
"stringUnit": {
"state": "translated",
"value": "Aktiviere Live-Aktivitäten für Publit in den Einstellungen, um die Fahrt auf dem Sperrbildschirm zu verfolgen."
}
},
"fr": {
"stringUnit": {
"state": "translated",
"value": "Activez les activités en direct pour Publit dans Réglages pour suivre le trajet sur l’écran verrouillé."
}
},
"it": {
"stringUnit": {
"state": "translated",
"value": "Attiva le Attività in tempo reale per Publit in Impostazioni per seguire il viaggio sulla schermata di blocco."
}
},
"es": {
"stringUnit": {
"state": "translated",
"value": "Activa las Actividades en Directo de Publit en Ajustes para seguir el viaje en la pantalla de bloqueo."
}
},
"pt-PT": {
"stringUnit": {
"state": "translated",
"value": "Ative as Atividades em direto do Publit nas Definições para acompanhar a viagem no ecrã bloqueado."
}
},
"nl": {
"stringUnit": {
"state": "translated",
"value": "Zet Live Activities voor Publit aan in Instellingen om de reis op het toegangsscherm te volgen."
}
},
"pl": {
"stringUnit": {
"state": "translated",
"value": "Włącz Aktywności na żywo dla Publit w Ustawieniach, aby śledzić podróż na ekranie blokady."
}
},
"uk": {
"stringUnit": {
"state": "translated",
"value": "Увімкніть «Активності наживо» для Publit у Налаштуваннях, щоб стежити за поїздкою на заблокованому екрані."
}
},
"ro": {
"stringUnit": {
"state": "translated",
"value": "Activați Activitățile live pentru Publit în Configurări pentru a urmări călătoria pe ecranul de blocare."
}
},
"cs": {
"stringUnit": {
"state": "translated",
"value": "Zapněte Živé aktivity pro Publit v Nastavení a sledujte cestu na zamčené obrazovce."
}
},
"sv": {
"stringUnit": {
"state": "translated",
"value": "Aktivera Live Activities för Publit i Inställningar för att följa resan på låsskärmen."
}
},
"el": {
"stringUnit": {
"state": "translated",
"value": "Ενεργοποιήστε τις Ζωντανές δραστηριότητες για το Publit στις Ρυθμίσεις για να παρακολουθείτε τη διαδρομή στην οθόνη κλειδώματος."
}
},
"hu": {
"stringUnit": {
"state": "translated",
"value": "Kapcsold be a Publit élő tevékenységeit a Beállításokban, hogy a zárolási képernyőn kövesd az utazást."
}
},
"tr": {
"stringUnit": {
"state": "translated",
"value": "Kilit ekranından takip etmek için Ayarlar'da Publit için Canlı Etkinlikler'i açın."
}
}
}
},
