"Vehicle positions are estimated from live departure times.": {
"extractionState": "manual",
"localizations": {
"en": {
"stringUnit": {
"state": "translated",
"value": "Vehicle positions are estimated from live departure times."
}
},
"de": {
"stringUnit": {
"state": "translated",
"value": "Fahrzeugpositionen sind aus aktuellen Abfahrtszeiten geschätzt."
}
},
"fr": {
"stringUnit": {
"state": "translated",
"value": "Les positions des véhicules sont estimées à partir des départs en temps réel."
}
},
"it": {
"stringUnit": {
"state": "translated",
"value": "Le posizioni dei mezzi sono stimate dagli orari di partenza in tempo reale."
}
},
"es": {
"stringUnit": {
"state": "translated",
"value": "Las posiciones de los vehículos se estiman con las salidas en tiempo real."
}
},
"pt-PT": {
"stringUnit": {
"state": "translated",
"value": "As posições dos veículos são estimadas a partir das partidas em tempo real."
}
},
"nl": {
"stringUnit": {
"state": "translated",
"value": "Voertuigposities zijn geschat op basis van actuele vertrektijden."
}
},
"pl": {
"stringUnit": {
"state": "translated",
"value": "Pozycje pojazdów są szacowane na podstawie bieżących odjazdów."
}
},
"uk": {
"stringUnit": {
"state": "translated",
"value": "Позиції транспорту оцінено за поточним часом відправлення."
}
},
"ro": {
"stringUnit": {
"state": "translated",
"value": "Pozițiile vehiculelor sunt estimate din orele de plecare în timp real."
}
},
"cs": {
"stringUnit": {
"state": "translated",
"value": "Polohy vozidel jsou odhadnuté z aktuálních časů odjezdů."
}
},
"sv": {
"stringUnit": {
"state": "translated",
"value": "Fordonens positioner uppskattas från aktuella avgångstider."
}
},
"el": {
"stringUnit": {
"state": "translated",
"value": "Οι θέσεις των οχημάτων εκτιμώνται από τις ώρες αναχώρησης σε πραγματικό χρόνο."
}
},
"hu": {
"stringUnit": {
"state": "translated",
"value": "A járművek helyzete az élő indulási időkből becsült."
}
},
"tr": {
"stringUnit": {
"state": "translated",
"value": "Araç konumları canlı kalkış saatlerinden tahmin edilir."
}
}
}
},
