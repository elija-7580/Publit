}
},
"nl": {
"stringUnit": {
"state": "translated",
"value": "Publit is open source (MIT). Geen account, geen advertenties, geen tracking. Bewaarde plaatsen, reizen en tickets blijven op dit apparaat."
}
},
"pl": {
"stringUnit": {
"state": "translated",
"value": "Publit jest open source (MIT). Bez konta, bez reklam, bez śledzenia. Zapisane miejsca, podróże i bilety zostają na tym urządzeniu."
}
},
"uk": {
"stringUnit": {
"state": "translated",
"value": "Publit має відкритий код (MIT). Без облікового запису, без реклами, без стеження. Збережені місця, поїздки й квитки залишаються на цьому пристрої."
}
},
"ro": {
"stringUnit": {
"state": "translated",
"value": "Publit este open source (MIT). Fără cont, fără reclame, fără urmărire. Locurile, călătoriile și biletele salvate rămân pe acest dispozitiv."
}
},
"cs": {
"stringUnit": {
"state": "translated",
"value": "Publit je open source (MIT). Žádný účet, žádné reklamy, žádné sledování. Uložená místa, cesty a jízdenky zůstávají v tomto zařízení."
}
},
"sv": {
"stringUnit": {
"state": "translated",
"value": "Publit är öppen källkod (MIT). Inget konto, ingen reklam, ingen spårning. Sparade platser, resor och biljetter stannar på enheten."
}
},
"el": {
"stringUnit": {
"state": "translated",
"value": "Το Publit είναι ανοιχτού κώδικα (MIT). Χωρίς λογαριασμό, χωρίς διαφημίσεις, χωρίς παρακολούθηση. Οι αποθηκευμένες τοποθεσίες, διαδρομές και εισιτήρια μένουν σε αυτή τη συσκευή."
}
},
"hu": {
"stringUnit": {
"state": "translated",
"value": "A Publit nyílt forráskódú (MIT). Nincs fiók, nincs reklám, nincs követés. A mentett helyek, utazások és jegyek ezen az eszközön maradnak."
}
},
"tr": {
"stringUnit": {
"state": "translated",
"value": "Publit açık kaynaklıdır (MIT). Hesap yok, reklam yok, takip yok. Kayıtlı yerler, yolculuklar ve biletler bu cihazda kalır."
}
}
}
},
"Publit reads the ticket on your iPhone. Nothing is uploaded. Codes that change every few seconds only work in the operator's app.": {
"extractionState": "manual",
"localizations": {
"en": {
"stringUnit": {
"state": "translated",
"value": "Publit reads the ticket on your iPhone. Nothing is uploaded. Codes that change every few seconds only work in the operator's app."
}
},
"de": {
"stringUnit": {
"state": "translated",
"value": "Publit liest das Ticket auf deinem iPhone. Nichts wird hochgeladen. Codes, die sich alle paar Sekunden ändern, funktionieren nur in der App des Verkehrsunternehmens."
}
},
"fr": {
"stringUnit": {
"state": "translated",
"value": "Publit lit le billet sur ton iPhone. Rien n’est envoyé. Les codes qui changent toutes les quelques secondes ne marchent que dans l’app de l’opérateur."
}
},
"it": {
"stringUnit": {
"state": "translated",
"value": "Publit legge il biglietto sul tuo iPhone. Non viene caricato nulla. I codici che cambiano ogni pochi secondi funzionano solo nell’app dell’operatore."
}
},
"es": {
"stringUnit": {
"state": "translated",
"value": "Publit lee el billete en tu iPhone. No se sube nada. Los códigos que cambian cada pocos segundos solo funcionan en la app del operador."
}
},
"pt-PT": {
"stringUnit": {
"state": "translated",
"value": "O Publit lê o bilhete no teu iPhone. Nada é enviado. Os códigos que mudam a cada poucos segundos só funcionam na app do operador."
}
},
"nl": {
"stringUnit": {
"state": "translated",
"value": "Publit leest het ticket op je iPhone. Er wordt niets geüpload. Codes die elke paar seconden veranderen werken alleen in de app van de vervoerder."
}
},
"pl": {
"stringUnit": {
"state": "translated",
"value": "Publit odczytuje bilet na iPhonie. Nic nie jest wysyłane. Kody zmieniające się co kilka sekund działają tylko w aplikacji przewoźnika."
}
},
"uk": {
"stringUnit": {
"state": "translated",
"value": "Publit читає квиток на твоєму iPhone. Нічого не завантажується. Коди, що змінюються кожні кілька секунд, працюють тільки в застосунку перевізника."
}
},
"ro": {
"stringUnit": {
"state": "translated",
"value": "Publit citește biletul pe iPhone. Nu se încarcă nimic. Codurile care se schimbă la câteva secunde merg doar în aplicația operatorului."
}
},
"cs": {
"stringUnit": {
"state": "translated",
"value": "Publit čte jízdenku přímo v iPhonu. Nic se nenahrává. Kódy, které se mění každých pár sekund, fungují jen v aplikaci dopravce."
}
},
"sv": {
"stringUnit": {
"state": "translated",
"value": "Publit läser biljetten på din iPhone. Inget laddas upp. Koder som byts ut med några sekunders mellanrum fungerar bara i trafikbolagets app."
}
},
"el": {
"stringUnit": {
"state": "translated",
"value": "Το Publit διαβάζει το εισιτήριο στο iPhone σου. Δεν ανεβαίνει τίποτα. Κωδικοί που αλλάζουν κάθε λίγα δευτερόλεπτα λειτουργούν μόνο στην εφαρμογή του φορέα."
}
},
"hu": {
"stringUnit": {
"state": "translated",
"value": "A Publit az iPhone-odon olvassa ki a jegyet. Semmi sem kerül feltöltésre. A néhány másodpercenként változó kódok csak a szolgáltató appjában működnek."
}
},
"tr": {
"stringUnit": {
"state": "translated",
"value": "Publit bileti iPhone’unda okur. Hiçbir şey yüklenmez. Birkaç saniyede bir değişen kodlar yalnızca işletmecinin uygulamasında çalışır."
}
}
}
},
