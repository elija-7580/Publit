  "Allow location access in Settings to see departures near you. Trip planning works without it.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Allow location access in Settings to see departures near you. Trip planning works without it."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Erlaube den Standortzugriff in den Einstellungen, um Abfahrten in deiner Nähe zu sehen. Routen kannst du auch ohne Standort planen."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Autorisez l'accès à la localisation dans Paramètres pour voir les départs près de chez vous. La planification du voyage fonctionne sans cela."
     }
    },
    "it": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Consenti l'accesso alla posizione nelle Impostazioni per vedere le partenze vicino a te. La pianificazione del viaggio funziona senza di essa."
     }
    },
    "es": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Permita el acceso a la ubicación en Configuración para ver salidas cerca de usted. La planificación de viajes funciona sin él."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Permita o acesso à localização em Configurações para ver as partidas perto de você. O planejamento de viagem funciona sem ele."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Sta locatietoegang toe in Instellingen om vertrektijden bij jou in de buurt te zien. Reisplanning werkt zonder."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Zezwól na dostęp do lokalizacji w Ustawieniach, aby zobaczyć odjazdy w Twojej okolicy. Planowanie podróży działa bez tego."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Дозвольте доступ до місцезнаходження в налаштуваннях, щоб бачити відправлення поблизу вас. Планування подорожі працює без нього."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Permiteți accesul la locație în Setări pentru a vedea plecările din apropiere. Planificarea călătoriei funcționează fără ea."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Povolte v Nastavení přístup k poloze, abyste viděli odjezdy ve vašem okolí. Plánování cesty funguje i bez něj."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Tillåt platsåtkomst i Inställningar för att se avgångar nära dig. Reseplanering fungerar utan den."
     }
    },
    "el": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Επιτρέψτε την πρόσβαση στην τοποθεσία στις Ρυθμίσεις για να δείτε τις αναχωρήσεις κοντά σας. Ο προγραμματισμός ταξιδιού λειτουργεί χωρίς αυτό."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Engedélyezze a helyhozzáférést a Beállításokban a közeli indulások megtekintéséhez. Az utazástervezés enélkül is működik."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Yakınınızdaki kalkış seferlerini görmek için Ayarlar'da konum erişimine izin verin. Seyahat planlaması onsuz çalışır."
     }
    }
   }
  },
