  "Times marked live come from the operator's real-time feed; all others are timetable times.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Times marked live come from the operator's real-time feed; all others are timetable times."
     }
    },
    "de": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Live markierte Zeiten stammen aus dem Echtzeit-Feed des Betreibers; alle anderen sind Fahrplanzeiten."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Les horaires marqués en direct proviennent du flux temps réel de l'opérateur ; tous les autres sont des horaires horaires."
     }
    },
    "it": {
     "stringUnit": {
      "state": "needs_review",
      "value": "I tempi segnati in live provengono dal feed in tempo reale dell'operatore; tutti gli altri sono orari."
     }
    },
    "es": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Los tiempos marcados en vivo provienen de la transmisión en tiempo real del operador; todos los demás son horarios."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Os horários marcados ao vivo provêm do feed em tempo real da operadora; todos os outros são horários."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Live gemarkeerde tijden komen uit de real-time feed van de operator; alle andere zijn dienstregelingstijden."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Czasy oznaczone na żywo pochodzą z kanału operatora w czasie rzeczywistym; wszystkie pozostałe to godziny rozkładowe."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Часи, позначені в реальному часі, надходять із каналу реального часу оператора; всі інші – це розклад."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Timpurile marcate live provin din fluxul în timp real al operatorului; toate celelalte sunt ore de orar."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Časy označené živě pocházejí z operátorova zdroje v reálném čase; všechny ostatní jsou jízdní řády."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Tider markerade live kommer från operatörens realtidsflöde; alla andra är tidtabellstider."
     }
    },
    "el": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Οι χρόνοι που σημειώνονται ζωντανά προέρχονται από τη ροή του χειριστή σε πραγματικό χρόνο. όλα τα άλλα είναι ώρες χρονοδιαγράμματος."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Az élőben megjelölt időpontok a kezelő valós idejű adatfolyamából származnak; az összes többi menetrend szerinti időpont."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Canlı olarak işaretlenen zamanlar operatörün gerçek zamanlı akışından gelir; diğerleri zaman çizelgesi zamanlarıdır."
     }
    }
   }
  },
