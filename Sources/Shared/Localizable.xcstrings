     "stringUnit": {
      "state": "needs_review",
      "value": "Повідомляє наступні відправлення на зупинці."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Vă spune următoarele plecări la o oprire."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Oznámí vám další odjezdy na zastávce."
     }
    },
