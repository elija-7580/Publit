  "Turn on Live Activities for Publit in Settings to follow it on the lock screen.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Turn on Live Activities for Publit in Settings to follow it on the lock screen."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Aktiviere Live-Aktivitäten für Publit in den Einstellungen, um die Fahrt auf dem Sperrbildschirm zu verfolgen."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Activez les activités en direct pour Publit dans Réglages pour suivre le trajet sur l’écran verrouillé."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva le Attività in tempo reale per Publit in Impostazioni per seguire il viaggio sulla schermata di blocco."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Activa las Actividades en Directo de Publit en Ajustes para seguir el viaje en la pantalla de bloqueo."
