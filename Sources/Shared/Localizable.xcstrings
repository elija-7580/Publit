"It may be too old or no longer in the timetable. You can search for it again.": {
"extractionState": "manual",
"localizations": {
"en": {
"stringUnit": {
"state": "translated",
"value": "It may be too old or no longer in the timetable. You can search for it again."
}
},
"de": {
"stringUnit": {
"state": "translated",
"value": "Vielleicht ist sie zu alt oder nicht mehr im Fahrplan. Du kannst sie neu suchen."
}
},
"fr": {
"stringUnit": {
"state": "translated",
"value": "Il est peut-être trop ancien ou ne figure plus dans l’horaire. Vous pouvez le rechercher à nouveau."
}
},
"it": {
"stringUnit": {
"state": "translated",
"value": "Potrebbe essere troppo vecchio o non più in orario. Puoi cercarlo di nuovo."
}
},
"es": {
"stringUnit": {
"state": "translated",
"value": "Puede que sea demasiado antigua o que ya no esté en el horario. Puedes buscarla de nuevo."
}
},
"pt-PT": {
"stringUnit": {
"state": "translated",
"value": "Pode ser demasiado antigo ou já não constar do horário. Pode procurá-lo novamente."
}
},
"nl": {
"stringUnit": {
"state": "translated",
"value": "Misschien is hij te oud of staat hij niet meer in de dienstregeling. Je kunt hem opnieuw zoeken."
}
},
"pl": {
"stringUnit": {
"state": "translated",
"value": "Może jest zbyt stara lub nie ma jej już w rozkładzie. Możesz wyszukać ją ponownie."
}
},
"uk": {
"stringUnit": {
"state": "translated",
"value": "Можливо, він застарів або його вже немає в розкладі. Ви можете знайти його знову."
}
},
"ro": {
"stringUnit": {
"state": "translated",
"value": "Poate este prea vechi sau nu mai figurează în orar. Îl poți căuta din nou."
}
},
"cs": {
"stringUnit": {
"state": "translated",
"value": "Možná je příliš staré nebo už není v jízdním řádu. Můžete ho vyhledat znovu."
}
},
"sv": {
"stringUnit": {
"state": "translated",
"value": "Den kan vara för gammal eller inte längre finnas i tidtabellen. Du kan söka efter den igen."
}
},
"el": {
"stringUnit": {
"state": "translated",
"value": "Ίσως είναι πολύ παλιά ή δεν υπάρχει πια στο δρομολόγιο. Μπορείτε να την αναζητήσετε ξανά."
}
},
"hu": {
"stringUnit": {
"state": "translated",
"value": "Lehet, hogy túl régi, vagy már nincs a menetrendben. Újra rákereshetsz."
}
},
"tr": {
"stringUnit": {
"state": "translated",
"value": "Çok eski olabilir veya artık tarifede olmayabilir. Yeniden arayabilirsin."
}
}
}
},
