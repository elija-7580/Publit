  "Tells you the next departures at a stop.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tells you the next departures at a stop."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Nennt die nächsten Abfahrten an einer Haltestelle."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Vous indique les prochains départs à un arrêt."
     }
    },
    "it": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Indica le prossime partenze ad una fermata."
     }
    },
