    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Affiche les meilleurs trajets pour rentrer depuis votre position, départ immédiat."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mostra i percorsi migliori per tornare a casa da dove sei, partendo ora."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Muestra las mejores rutas a casa desde donde estás, saliendo ahora."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "translated",
      "value": "Mostra as melhores ligações para casa a partir de onde está, com partida agora."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Toont de beste verbindingen naar huis vanaf waar je bent, met vertrek nu."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Pokazuje najlepsze połączenia do domu z miejsca, w którym jesteś, z odjazdem teraz."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Показує найкращі маршрути додому з вашого місця, з відправленням зараз."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "translated",
      "value": "Afișează cele mai bune legături spre casă de unde vă aflați, cu plecare acum."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "translated",
      "value": "Ukáže nejlepší spojení domů z místa, kde jste, s odjezdem hned."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "translated",
      "value": "Visar de bästa resorna hem från där du är, med avgång nu."
     }
    },
    "el": {
     "stringUnit": {
      "state": "translated",
      "value": "Δείχνει τις καλύτερες διαδρομές για το σπίτι από εκεί που είστε, με αναχώρηση τώρα."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "translated",
      "value": "Megmutatja a legjobb utat haza onnan, ahol vagy, azonnali indulással."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Bulunduğunuz yerden eve en iyi bağlantıları, hemen kalkışla gösterir."
     }
    }
   }
  },
