      "state": "translated",
      "value": "Aktualisierung fehlgeschlagen. Zeiten möglicherweise veraltet."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Actualisation impossible. Les horaires peuvent être dépassés."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggiornamento non riuscito. Gli orari potrebbero non essere aggiornati."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No se pudo actualizar. Los horarios pueden estar desfasados."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "translated",
      "value": "Não foi possível atualizar. Os horários podem estar desatualizados."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Vernieuwen mislukt. Tijden zijn mogelijk verouderd."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Nie udało się odświeżyć. Czasy mogą być nieaktualne."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Не вдалося оновити. Час може бути застарілим."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "translated",
      "value": "Actualizare eșuată. Orele pot fi depășite."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "translated",
      "value": "Obnovení selhalo. Časy mohou být zastaralé."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "translated",
      "value": "Kunde inte uppdatera. Tiderna kan vara inaktuella."
     }
    },
    "el": {
     "stringUnit": {
      "state": "translated",
      "value": "Η ανανέωση απέτυχε. Οι ώρες ίσως δεν είναι επίκαιρες."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "translated",
      "value": "A frissítés nem sikerült. Az időpontok elavultak lehetnek."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Yenilenemedi. Saatler güncel olmayabilir."
     }
    }
   }
  },
