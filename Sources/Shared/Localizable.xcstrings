"This search took too long. Try again, or choose walking to the first stop.": {
"extractionState": "manual",
"localizations": {
"cs": {
"stringUnit": {
"state": "translated",
"value": "Hledání trvalo příliš dlouho. Zkuste to znovu nebo zvolte chůzi k první zastávce."
}
},
"de": {
"stringUnit": {
"state": "translated",
"value": "Diese Suche hat zu lange gedauert. Versuch es noch einmal oder wähle „zu Fuß“ zur ersten Haltestelle."
}
},
"el": {
"stringUnit": {
"state": "translated",
"value": "Η αναζήτηση καθυστέρησε πολύ. Δοκιμάστε ξανά ή επιλέξτε περπάτημα έως την πρώτη στάση."
}
},
"en": {
"stringUnit": {
"state": "translated",
"value": "This search took too long. Try again, or choose walking to the first stop."
}
},
"es": {
"stringUnit": {
"state": "translated",
"value": "La búsqueda ha tardado demasiado. Inténtalo de nuevo o elige ir a pie hasta la primera parada."
}
},
"fr": {
"stringUnit": {
"state": "translated",
"value": "Cette recherche a pris trop de temps. Réessayez ou choisissez la marche jusqu’au premier arrêt."
}
},
"hu": {
"stringUnit": {
"state": "translated",
"value": "A keresés túl sokáig tartott. Próbáld újra, vagy válaszd a gyaloglást az első megállóig."
}
},
"it": {
"stringUnit": {
"state": "translated",
"value": "La ricerca ha richiesto troppo tempo. Riprova o scegli a piedi fino alla prima fermata."
}
},
"nl": {
"stringUnit": {
"state": "translated",
"value": "Deze zoekopdracht duurde te lang. Probeer het opnieuw of kies lopen naar de eerste halte."
}
},
"pl": {
"stringUnit": {
"state": "translated",
"value": "Wyszukiwanie trwało zbyt długo. Spróbuj ponownie lub wybierz dojście pieszo do pierwszego przystanku."
}
},
"pt-PT": {
"stringUnit": {
"state": "translated",
