"Scheduled times. Live delays are on the departure board.": {
"extractionState": "manual",
"localizations": {
"en": {
"stringUnit": {
"state": "translated",
"value": "Scheduled times. Live delays are on the departure board."
}
},
"de": {
"stringUnit": {
"state": "translated",
"value": "Fahrplanzeiten. Aktuelle Verspätungen stehen in der Abfahrtstafel."
}
},
"fr": {
"stringUnit": {
"state": "translated",
"value": "Horaires prévus. Les retards en temps réel sont sur le tableau des départs."
}
},
"it": {
"stringUnit": {
"state": "translated",
"value": "Orari programmati. I ritardi in tempo reale sono nel tabellone delle partenze."
}
},
"es": {
"stringUnit": {
"state": "translated",
"value": "Horarios programados. Los retrasos en tiempo real están en el panel de salidas."
}
},
"pt-PT": {
"stringUnit": {
"state": "translated",
"value": "Horários previstos. Os atrasos em tempo real estão no painel de partidas."
}
},
"nl": {
"stringUnit": {
"state": "translated",
"value": "Geplande tijden. Actuele vertragingen staan op het vertrekbord."
}
},
"pl": {
"stringUnit": {
"state": "translated",
"value": "Godziny rozkładowe. Bieżące opóźnienia są na tablicy odjazdów."
}
},
"uk": {
"stringUnit": {
"state": "translated",
"value": "Час за розкладом. Поточні затримки — на табло відправлень."
}
},
"ro": {
"stringUnit": {
"state": "translated",
"value": "Ore din orar. Întârzierile în timp real sunt pe panoul de plecări."
}
},
"cs": {
"stringUnit": {
"state": "translated",
"value": "Časy podle jízdního řádu. Aktuální zpoždění jsou na odjezdové tabuli."
}
},
"sv": {
"stringUnit": {
"state": "translated",
"value": "Tidtabellstider. Aktuella förseningar finns på avgångstavlan."
}
},
"el": {
"stringUnit": {
"state": "translated",
"value": "Προγραμματισμένες ώρες. Οι καθυστερήσεις σε πραγματικό χρόνο είναι στον πίνακα αναχωρήσεων."
}
},
"hu": {
"stringUnit": {
"state": "translated",
"value": "Menetrend szerinti idők. Az élő késések az indulási táblán láthatók."
}
},
"tr": {
"stringUnit": {
"state": "translated",
"value": "Tarife saatleri. Canlı gecikmeler kalkış tablosunda."
}
}
}
