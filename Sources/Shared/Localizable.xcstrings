"Routes only use the modes that are switched on.": {
"extractionState": "manual",
"localizations": {
"en": {
"stringUnit": {
"state": "translated",
"value": "Routes only use the modes that are switched on."
}
},
"de": {
"stringUnit": {
"state": "translated",
"value": "Routen nutzen nur die eingeschalteten Verkehrsmittel."
}
},
"fr": {
"stringUnit": {
"state": "translated",
"value": "Les itinéraires n’utilisent que les modes activés."
}
},
"it": {
"stringUnit": {
"state": "translated",
"value": "I percorsi usano solo i mezzi attivati."
}
},
"es": {
"stringUnit": {
"state": "translated",
"value": "Las rutas solo usan los medios activados."
}
},
"pt-PT": {
