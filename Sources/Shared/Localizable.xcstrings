  "Set Home and Work in Saved to plan there with one tap.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set Home and Work in Saved to plan there with one tap."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Lege Zuhause und Arbeit unter Gespeichert fest, um mit einem Tippen dorthin zu planen."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Définissez Domicile et Travail dans Enregistré pour y planifier en un seul clic."
     }
    },
    "it": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Imposta Casa e Lavoro in Salvati per pianificare lì con un solo tocco."
     }
    },
    "es": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Configure Casa y Trabajo en Guardado para planificar allí con un toque."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Defina Casa e Trabalho em Salvo para planejar lá com um toque."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Stel Thuis en Werk in Opgeslagen in om daar met één tik te plannen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Ustaw Dom i Pracę w Zapisanych, aby planować je jednym dotknięciem."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Налаштуйте «Дім» і «Робота» в «Збережених», щоб планувати там одним дотиком."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Setați Acasă și serviciu în Salvat pentru a planifica acolo cu o singură atingere."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Jedním klepnutím nastavte Domů a Práce v Uložených a plánujte tam."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Ställ in Hem och Arbete i Sparat för att planera där med ett tryck."
     }
    },
    "el": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Ρυθμίστε το σπίτι και την εργασία στο Αποθηκευμένο για να προγραμματίσετε εκεί με ένα πάτημα."
     }
