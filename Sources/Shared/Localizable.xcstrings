"You shared your arrival at %@. Tap to send the new time.": {
"extractionState": "manual",
"localizations": {
"en": {
"stringUnit": {
"state": "translated",
"value": "You shared your arrival at %@. Tap to send the new time."
}
},
"de": {
"stringUnit": {
"state": "translated",
"value": "Du hast deine Ankunft in %@ geteilt. Tippe, um die neue Zeit zu senden."
}
},
"fr": {
"stringUnit": {
"state": "translated",
"value": "Vous avez partagé votre arrivée à %@. Touchez pour envoyer la nouvelle heure."
}
},
"it": {
"stringUnit": {
"state": "translated",
"value": "Hai condiviso il tuo arrivo a %@. Tocca per inviare il nuovo orario."
}
},
"es": {
"stringUnit": {
"state": "translated",
"value": "Compartiste tu llegada a %@. Toca para enviar la nueva hora."
}
},
"pt-PT": {
"stringUnit": {
"state": "translated",
"value": "Partilhou a sua chegada a %@. Toque para enviar a nova hora."
}
},
"nl": {
"stringUnit": {
"state": "translated",
"value": "Je hebt je aankomst in %@ gedeeld. Tik om de nieuwe tijd te sturen."
}
},
"pl": {
"stringUnit": {
"state": "translated",
"value": "Udostępniono przyjazd do %@. Stuknij, aby wysłać nową godzinę."
}
},
"uk": {
"stringUnit": {
"state": "translated",
"value": "Ви поділилися прибуттям до %@. Торкніться, щоб надіслати новий час."
}
},
"ro": {
"stringUnit": {
"state": "translated",
"value": "Ai distribuit sosirea la %@. Atinge pentru a trimite noua oră."
}
},
"cs": {
"stringUnit": {
"state": "translated",
"value": "Sdílel(a) jsi příjezd do %@. Klepni a pošli nový čas."
}
},
"sv": {
"stringUnit": {
"state": "translated",
"value": "Du delade din ankomst till %@. Tryck för att skicka den nya tiden."
}
