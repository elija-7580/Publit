  "Live tracking is active in the app. Lock screen updates may be unavailable.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Live tracking runs in the app. The lock screen may not update."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Live-Begleitung läuft in der App. Der Sperrbildschirm wird eventuell nicht aktualisiert."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Suivi en direct actif dans l’app. L’écran verrouillé peut ne pas se mettre à jour."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Monitoraggio in tempo reale attivo nell’app. La schermata di blocco potrebbe non aggiornarsi."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Seguimiento en directo activo en la app. Puede que la pantalla de bloqueo no se actualice."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "translated",
      "value": "Acompanhamento em tempo real ativo na app. O ecrã bloqueado pode não atualizar."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Live volgen is actief in de app. Het toegangsscherm wordt mogelijk niet bijgewerkt."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Śledzenie na żywo działa w aplikacji. Ekran blokady może się nie aktualizować."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Відстеження наживо працює в застосунку. Заблокований екран може не оновлюватися."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "translated",
      "value": "Urmărirea în timp real e activă în aplicație. Ecranul de blocare s-ar putea să nu se actualizeze."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "translated",
      "value": "Živé sledování běží v aplikaci. Zamčená obrazovka se nemusí aktualizovat."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "translated",
      "value": "Realtidsföljning är aktiv i appen. Låsskärmen uppdateras kanske inte."
     }
    },
    "el": {
     "stringUnit": {
      "state": "translated",
      "value": "Η ζωντανή παρακολούθηση λειτουργεί στην εφαρμογή. Η οθόνη κλειδώματος ίσως δεν ενημερώνεται."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "translated",
      "value": "Az élő követés az appban fut. A zárolási képernyő lehet, hogy nem frissül."
     }
    },
