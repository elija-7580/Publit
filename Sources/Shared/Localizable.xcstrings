  "Save stops from their departure board, lines from a trip, or add places with +.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Save stops from their departure board, lines from a trip, or add places with +."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Speichere Haltestellen über ihre Abfahrtstafel und Linien über eine Fahrt. Orte fügst du mit + hinzu."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Enregistrez des arrêts depuis leur tableau des départs, des lignes depuis un trajet, ou ajoutez des lieux avec +."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salva le fermate dal loro tabellone, le linee da un viaggio, oppure aggiungi luoghi con +."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Guarda paradas desde su panel de salidas, líneas desde un viaje, o añade lugares con +."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "translated",
      "value": "Guarde paragens a partir do quadro de partidas, linhas a partir de uma viagem, ou adicione locais com +."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Bewaar haltes via hun vertrekbord, lijnen via een reis, of voeg plaatsen toe met +."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Zapisuj przystanki z tablicy odjazdów, linie z podróży albo dodawaj miejsca przyciskiem +."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Зберігайте зупинки з табло відправлень, лінії з поїздки або додавайте місця кнопкою +."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "translated",
      "value": "Salvați stații din tabela de plecări, linii dintr-o călătorie sau adăugați locuri cu +."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "translated",
      "value": "Ukládejte zastávky z jejich odjezdové tabule, linky z cesty, nebo přidejte místa tlačítkem +."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "translated",
      "value": "Spara hållplatser från deras avgångstavla, linjer från en resa, eller lägg till platser med +."
     }
    },
    "el": {
     "stringUnit": {
      "state": "translated",
      "value": "Αποθηκεύστε στάσεις από τον πίνακα αναχωρήσεων, γραμμές από μια διαδρομή, ή προσθέστε τοποθεσίες με +."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "translated",
      "value": "A megállókat az indulási táblájukról, a vonalakat egy utazásból mentheted, helyeket pedig a + gombbal adhatsz hozzá."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Durakları kalkış tablolarından, hatları bir yolculuktan kaydedin ya da + ile yer ekleyin."
     }
    }
   }
  },
