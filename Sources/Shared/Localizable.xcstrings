"Tap a stop for its timetable.": {
"extractionState": "manual",
"localizations": {
"en": {
"stringUnit": {
"state": "translated",
"value": "Tap a stop for its timetable."
}
},
"de": {
"stringUnit": {
"state": "translated",
"value": "Tippe auf einen Halt für seinen Fahrplan."
}
},
"fr": {
"stringUnit": {
"state": "translated",
"value": "Touchez un arrêt pour voir ses horaires."
}
},
"it": {
"stringUnit": {
"state": "translated",
"value": "Tocca una fermata per vederne gli orari."
}
},
