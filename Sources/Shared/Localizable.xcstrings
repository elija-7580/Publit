  "Publit is open source (MIT). No account, no ads, no tracking. Saved places, trips and tickets stay on this device.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit is open source (MIT). No account, no ads, no tracking. Saved places, trips and tickets stay on this device."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit ist Open Source (MIT). Kein Konto, keine Werbung, kein Tracking. Gespeicherte Orte, Fahrten und Tickets bleiben auf diesem Gerät."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit est open source (MIT). Sans compte, sans publicité, sans pistage. Vos lieux, trajets et billets restent sur cet appareil."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit è open source (MIT). Nessun account, nessuna pubblicità, nessun tracciamento. Luoghi, viaggi e biglietti salvati restano su questo dispositivo."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit es de código abierto (MIT). Sin cuenta, sin anuncios, sin rastreo. Tus lugares, viajes y billetes guardados se quedan en este dispositivo."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "translated",
      "value": "O Publit é open source (MIT). Sem conta, sem anúncios, sem rastreio. Locais, viagens e bilhetes guardados ficam neste dispositivo."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit is open source (MIT). Geen account, geen advertenties, geen tracking. Bewaarde plaatsen, reizen en tickets blijven op dit apparaat."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit jest open source (MIT). Bez konta, bez reklam, bez śledzenia. Zapisane miejsca, podróże i bilety zostają na tym urządzeniu."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit має відкритий код (MIT). Без облікового запису, без реклами, без стеження. Збережені місця, поїздки й квитки залишаються на цьому пристрої."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit este open source (MIT). Fără cont, fără reclame, fără urmărire. Locurile, călătoriile și biletele salvate rămân pe acest dispozitiv."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit je open source (MIT). Žádný účet, žádné reklamy, žádné sledování. Uložená místa, cesty a jízdenky zůstávají v tomto zařízení."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit är öppen källkod (MIT). Inget konto, ingen reklam, ingen spårning. Sparade platser, resor och biljetter stannar på enheten."
     }
    },
    "el": {
     "stringUnit": {
      "state": "translated",
      "value": "Το Publit είναι ανοιχτού κώδικα (MIT). Χωρίς λογαριασμό, χωρίς διαφημίσεις, χωρίς παρακολούθηση. Οι αποθηκευμένες τοποθεσίες, διαδρομές και εισιτήρια μένουν σε αυτή τη συσκευή."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "translated",
      "value": "A Publit nyílt forráskódú (MIT). Nincs fiók, nincs reklám, nincs követés. A mentett helyek, utazások és jegyek ezen az eszközön maradnak."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit açık kaynaklıdır (MIT). Hesap yok, reklam yok, takip yok. Kayıtlı yerler, yolculuklar ve biletler bu cihazda kalır."
     }
    }
   }
  },
