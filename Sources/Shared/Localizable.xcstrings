  "Shows the best ways home from where you are, leaving now.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Shows the best ways home from where you are, leaving now."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Zeigt die besten Verbindungen nach Hause ab deinem Standort, mit Abfahrt jetzt."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Affiche les meilleurs chemins pour rentrer chez vous à partir de là où vous êtes, en partant maintenant."
     }
    },
    "it": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Mostra i modi migliori per tornare a casa da dove ti trovi, partendo adesso."
     }
    },
    "es": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Muestra los mejores caminos a casa desde donde estás, saliendo ahora."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Mostra os melhores caminhos para casa a partir de onde você está, saindo agora."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Toont de beste manieren om naar huis te gaan vanaf waar u zich nu bevindt."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Wskazuje najlepszą drogę do domu z miejsca, w którym aktualnie się znajdujesz."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Показує найкращі шляхи додому з того місця, де ви зараз вирушаєте."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Afișează cele mai bune drumuri spre casă de unde vă aflați, plecând acum."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Zobrazuje nejlepší cesty domů z místa, kde se právě nacházíte."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Visar de bästa vägarna hem från där du är, och åker nu."
     }
    },
    "el": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Δείχνει τους καλύτερους τρόπους για το σπίτι από εκεί που βρίσκεστε, φεύγοντας τώρα."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Megmutatja a legjobb utakat hazafelé onnan, ahol most indul."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Bulunduğunuz yerden eve dönmenin en iyi yollarını gösterir, şimdi yola çıkıyor."
     }
    }
   }
  },
  "Shows the best ways to work from where you are, leaving now.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Shows the best ways to work from where you are, leaving now."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Zeigt die besten Verbindungen zur Arbeit ab deinem Standort, mit Abfahrt jetzt."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Affiche les meilleures façons de travailler là où vous êtes, en partant maintenant."
     }
    },
    "it": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Mostra le modalità migliori per lavorare da dove ti trovi, partendo adesso."
     }
    },
    "es": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Muestra las mejores formas de trabajar desde donde estás, saliendo ahora."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Mostra as melhores formas de trabalhar de onde você está, saindo agora."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Toont de beste manieren om te werken vanaf waar u nu bent."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Pokazuje najlepsze sposoby pracy z miejsca, w którym się znajdujesz, wychodząc teraz."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Показує найкращі способи роботи з того місця, де ви зараз йдете."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Afișează cele mai bune modalități de a lucra de unde vă aflați, plecând acum."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Ukazuje nejlepší způsoby, jak pracovat z místa, kde se právě nacházíte."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Visar de bästa sätten att arbeta där du är, och lämna nu."
     }
    },
    "el": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Δείχνει τους καλύτερους τρόπους εργασίας από εκεί που βρίσκεστε, φεύγοντας τώρα."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Megmutatja a legjobb munkamódszereket onnan, ahol éppen van, most távozva."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Bulunduğunuz yerden çalışmanın en iyi yollarını gösterir, şimdi ayrılıyorsunuz."
     }
    }
   }
  },
