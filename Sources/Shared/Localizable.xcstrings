  "Times marked live come from the operator's real-time feed; all others are timetable times.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Times marked live come from the operator's real-time feed; all others are timetable times."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Als live markierte Zeiten stammen aus dem Echtzeit-Feed des Betreibers, alle anderen sind Fahrplanzeiten."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les horaires marqués « en direct » viennent du flux temps réel de l’opérateur ; les autres sont des horaires théoriques."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Gli orari indicati in tempo reale arrivano dal feed dell’operatore; gli altri sono orari programmati."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los horarios marcados en directo vienen del sistema en tiempo real del operador; los demás son horarios programados."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "translated",
      "value": "Os horários marcados em tempo real vêm do sistema do operador; os restantes são horários programados."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Tijden met ‘live’ komen uit de realtime-gegevens van de vervoerder; de rest zijn dienstregelingstijden."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Czasy oznaczone jako na żywo pochodzą z danych przewoźnika w czasie rzeczywistym; pozostałe są rozkładowe."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Час із позначкою «наживо» надходить від перевізника в реальному часі; решта — за розкладом."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "translated",
      "value": "Orele marcate în timp real vin din datele operatorului; celelalte sunt ore din orar."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "translated",
      "value": "Časy označené jako živé pocházejí z dat dopravce v reálném čase; ostatní jsou podle jízdního řádu."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "translated",
      "value": "Tider märkta realtid kommer från operatörens realtidsdata; övriga är tidtabellstider."
     }
    },
    "el": {
     "stringUnit": {
      "state": "translated",
      "value": "Οι ώρες με την ένδειξη «ζωντανά» προέρχονται από τα δεδομένα πραγματικού χρόνου του φορέα· οι υπόλοιπες είναι ώρες δρομολογίου."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "translated",
      "value": "Az élőként jelölt időpontok a szolgáltató valós idejű adataiból származnak; a többi menetrendi idő."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Canlı işaretli saatler işletmecinin gerçek zamanlı verisinden gelir; diğerleri tarife saatleridir."
     }
    }
   }
  },
