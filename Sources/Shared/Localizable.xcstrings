"Step-free routes avoid stairs where the data allows it.": {
"extractionState": "manual",
"localizations": {
"en": {
"stringUnit": {
"state": "translated",
"value": "Step-free routes avoid stairs where the data allows it."
}
},
"de": {
"stringUnit": {
"state": "translated",
"value": "Stufenfreie Routen meiden Treppen, soweit die Daten das erlauben."
}
},
"fr": {
"stringUnit": {
"state": "translated",
"value": "Les itinéraires sans marches évitent les escaliers lorsque les données le permettent."
}
},
"it": {
"stringUnit": {
"state": "translated",
"value": "I percorsi senza gradini evitano le scale dove i dati lo consentono."
}
},
