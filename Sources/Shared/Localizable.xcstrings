  "Publit is open source (MIT). No account, no ads, no tracking. Saved places, trips and tickets stay on this device.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit is open source (MIT). No account, no ads, no tracking. Saved places, trips and tickets stay on this device."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Publit ist Open Source (MIT). Kein Konto, keine Werbung, kein Tracking. Gespeicherte Orte, Fahrten und Tickets bleiben auf diesem Gerät."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Publit est open source (MIT). Pas de compte, pas de publicité, pas de suivi. Les lieux, voyages et billets enregistrés restent sur cet appareil."
     }
    },
    "it": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Publit è open source (MIT). Nessun account, nessuna pubblicità, nessun monitoraggio. I luoghi, i viaggi e i biglietti salvati rimangono su questo dispositivo."
     }
    },
    "es": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Publit es de código abierto (MIT). Sin cuenta, sin anuncios, sin seguimiento. Los lugares, viajes y billetes guardados permanecen en este dispositivo."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Publit é de código aberto (MIT). Sem conta, sem anúncios, sem rastreamento. Os lugares, viagens e ingressos salvos permanecem neste dispositivo."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Publit is open source (MIT). Geen account, geen advertenties, geen tracking. Opgeslagen plaatsen, reizen en tickets blijven op dit apparaat staan."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Publikacja jest oprogramowaniem typu open source (MIT). Bez konta, bez reklam i bez śledzenia. Zapisane miejsca, wycieczki i bilety pozostają na tym urządzeniu."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Publit є відкритим кодом (MIT). Ні облікового запису, ні реклами, ні відстеження. Збережені місця, поїздки та квитки залишаються на цьому пристрої."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Publit este open source (MIT). Fără cont, fără reclame, fără urmărire. Locurile, călătoriile și biletele salvate rămân pe acest dispozitiv."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Publit je open source (MIT). Žádný účet, žádné reklamy, žádné sledování. Uložená místa, cesty a vstupenky zůstávají v tomto zařízení."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Publit är öppen källkod (MIT). Inget konto, inga annonser, ingen spårning. Sparade platser, resor och biljetter stannar på den här enheten."
     }
    },
    "el": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Το Publit είναι ανοιχτού κώδικα (MIT). Χωρίς λογαριασμό, χωρίς διαφημίσεις, χωρίς παρακολούθηση. Τα αποθηκευμένα μέρη, τα ταξίδια και τα εισιτήρια παραμένουν σε αυτήν τη συσκευή."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "needs_review",
      "value": "A Publit nyílt forráskódú (MIT). Nincs fiók, nincsenek hirdetések, nincs nyomon követés. A mentett helyek, utazások és jegyek ezen az eszközön maradnak."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Publit açık kaynaktır (MIT). Hesap yok, reklam yok, takip yok. Kaydedilen yerler, geziler ve biletler bu cihazda kalır."
     }
    }
   }
  },
