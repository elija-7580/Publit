"Read on your iPhone. Check every detail before you save.": {
"extractionState": "manual",
"localizations": {
"en": {
"stringUnit": {
"state": "translated",
"value": "Read on your iPhone. Check every detail before you save."
}
},
"de": {
"stringUnit": {
"state": "translated",
"value": "Auf deinem iPhone gelesen. Prüf alle Angaben, bevor du speicherst."
}
},
"fr": {
"stringUnit": {
"state": "translated",
"value": "Lu sur ton iPhone. Vérifie chaque détail avant d’enregistrer."
}
},
"it": {
"stringUnit": {
"state": "translated",
"value": "Letto sul tuo iPhone. Controlla ogni dato prima di salvare."
}
},
"es": {
"stringUnit": {
"state": "translated",
"value": "Leído en tu iPhone. Revisa cada dato antes de guardar."
}
},
"pt-PT": {
"stringUnit": {
"state": "translated",
"value": "Lido no teu iPhone. Verifica cada dado antes de guardar."
}
},
"nl": {
"stringUnit": {
"state": "translated",
"value": "Gelezen op je iPhone. Controleer alle gegevens voordat je bewaart."
}
},
"pl": {
"stringUnit": {
"state": "translated",
"value": "Odczytano na iPhonie. Sprawdź wszystkie dane przed zapisaniem."
}
},
"uk": {
"stringUnit": {
"state": "translated",
"value": "Прочитано на твоєму iPhone. Перевір усі дані перед збереженням."
}
},
"ro": {
