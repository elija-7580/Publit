  "Save a route to see it here, add it to your calendar and get a reminder when to leave.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Save a route to see it here, add it to your calendar and get a reminder when to leave."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Speichere eine Route, um sie hier zu sehen, in deinen Kalender einzutragen und dich ans Losgehen erinnern zu lassen."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Enregistrez un itinéraire pour le voir ici, ajoutez-le à votre calendrier et recevez un rappel quand partir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Salva un percorso per vederlo qui, aggiungilo al tuo calendario e ricevi un promemoria quando partire."
     }
    },
    "es": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Guarde una ruta para verla aquí, agréguela a su calendario y reciba un recordatorio de cuándo salir."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Salve uma rota para vê-la aqui, adicione-a ao seu calendário e receba um lembrete de quando sair."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Bewaar een route om deze hier te bekijken, voeg hem toe aan je agenda en ontvang een herinnering wanneer je moet vertrekken."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Zapisz trasę, aby zobaczyć ją tutaj, dodaj ją do swojego kalendarza i otrzymuj przypomnienie, kiedy wyjechać."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Збережіть маршрут, щоб побачити його тут, додайте його до свого календаря та отримуйте нагадування, коли потрібно вирушати."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Salvați un traseu pentru a-l vedea aici, adăugați-l în calendar și primiți un memento când să plecați."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Uložte si trasu, abyste ji viděli zde, přidejte si ji do kalendáře a získejte připomenutí, kdy vyrazit."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Spara en rutt för att se den här, lägg till den i din kalender och få en påminnelse när du ska åka."
     }
    },
    "el": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Αποθηκεύστε μια διαδρομή για να τη δείτε εδώ, προσθέστε τη στο ημερολόγιό σας και λάβετε μια υπενθύμιση πότε πρέπει να φύγετε."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Mentsen el egy útvonalat, hogy itt megtekinthesse, adja hozzá a naptárához, és kapjon emlékeztetőt az indulásra."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Burada görmek için bir rota kaydedin, takviminize ekleyin ve ne zaman yola çıkmanız gerektiğini hatırlatın."
     }
    }
   }
  },
