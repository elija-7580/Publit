     "stringUnit": {
      "state": "translated",
      "value": "Defina Casa e Trabalho em Guardados para planear com um toque."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Stel Thuis en Werk in onder Bewaard om er met één tik heen te plannen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Ustaw Dom i Pracę w Zapisanych, aby planować tam jednym dotknięciem."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Укажіть Дім і Роботу в Збереженому, щоб планувати туди одним дотиком."
     }
    },
    "ro": {
     "stringUnit": {
