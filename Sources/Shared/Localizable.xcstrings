"state": "translated",
"value": "Os percursos só usam os meios ativados."
}
},
"nl": {
"stringUnit": {
"state": "translated",
"value": "Routes gebruiken alleen de ingeschakelde vervoermiddelen."
}
},
"pl": {
"stringUnit": {
"state": "translated",
"value": "Trasy korzystają tylko z włączonych środków transportu."
}
},
"uk": {
"stringUnit": {
"state": "translated",
"value": "Маршрути використовують лише ввімкнені види транспорту."
}
},
"ro": {
"stringUnit": {
"state": "translated",
"value": "Traseele folosesc doar mijloacele activate."
}
},
"cs": {
"stringUnit": {
"state": "translated",
"value": "Trasy používají jen zapnuté dopravní prostředky."
}
},
"sv": {
"stringUnit": {
"state": "translated",
"value": "Rutter använder bara de färdmedel som är på."
}
},
"el": {
"stringUnit": {
"state": "translated",
"value": "Οι διαδρομές χρησιμοποιούν μόνο τα ενεργά μέσα."
}
},
"hu": {
"stringUnit": {
"state": "translated",
