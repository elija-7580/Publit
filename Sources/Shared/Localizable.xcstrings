  "The calendar entry links back to this trip with its live status.": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The calendar entry links back to this trip with its live status."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Der Kalendereintrag öffnet diese Fahrt mit ihrem Live-Status."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "L'entrée du calendrier renvoie à ce voyage avec son statut en direct."
     }
    },
    "it": {
     "stringUnit": {
      "state": "needs_review",
      "value": "La voce del calendario si collega a questo viaggio con il suo stato in tempo reale."
     }
    },
    "es": {
     "stringUnit": {
      "state": "needs_review",
      "value": "La entrada del calendario enlaza con este viaje con su estado en vivo."
     }
    },
    "pt-PT": {
     "stringUnit": {
      "state": "needs_review",
      "value": "A entrada do calendário remete a esta viagem com seu status ativo."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Het agenda-item linkt terug naar deze reis met zijn livestatus."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Wpis w kalendarzu łączy się z tą podróżą i jej statusem na żywo."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Запис у календарі посилається на цю поїздку з її активним статусом."
     }
    },
    "ro": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Înregistrarea din calendar se leagă înapoi la această călătorie cu starea ei live."
     }
    },
    "cs": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Záznam v kalendáři odkazuje zpět na tuto cestu s jejím živým stavem."
     }
    },
    "sv": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Kalenderposten länkar tillbaka till denna resa med dess livestatus."
     }
    },
    "el": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Η καταχώριση ημερολογίου συνδέεται πίσω με αυτό το ταξίδι με τη ζωντανή του κατάσταση."
     }
    },
    "hu": {
     "stringUnit": {
      "state": "needs_review",
      "value": "A naptárbejegyzés erre az útra hivatkozik, annak élő állapotával."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "needs_review",
      "value": "Takvim girişi, canlı durumuyla birlikte bu geziye bağlantı veriyor."
     }
    }
